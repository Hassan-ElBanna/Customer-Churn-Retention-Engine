# =============================================================================
# GitHub & DagsHub (MLflow + DVC) Credentials Template
# Copy this file to `.env` and fill in your credentials (`.env` is git-ignored)
# =============================================================================

# 1. DagsHub Repository Info
DAGSHUB_REPO_OWNER=hmelbanna100
DAGSHUB_REPO_NAME=Customer-Churn-Retention-Engine
DAGSHUB_USER_TOKEN=your_dagshub_access_token

# 2. MLflow Tracking (Automatically populated from DagsHub settings if left blank)
MLFLOW_TRACKING_URI=https://dagshub.com/hmelbanna100/Customer-Churn-Retention-Engine.mlflow
MLFLOW_TRACKING_USERNAME=hmelbanna100
MLFLOW_TRACKING_PASSWORD=your_dagshub_access_token

# 3. GitHub Repository URL
GITHUB_REPO_URL=https://github.com/Hassan-ElBanna/Customer-Churn-Retention-Engine.git
